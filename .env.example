# Local development configuration. Copy to .env and adjust; never commit .env.
APP_NAME=Children's Bible Study Group API
ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://schoolops:schoolops@localhost:5433/schoolops
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# Replace before any non-local deployment. Use at least 32 characters.
JWT_SECRET=dev-only-change-me-please-use-32-chars
ACCESS_TOKEN_TTL_MINUTES=480

# Reject larger request bodies at the API edge (bytes).
MAX_REQUEST_BODY_BYTES=1048576
